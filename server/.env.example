# Copy this file to .env and fill in real values. Never commit .env.

# --- Database -----------------------------------------------------------
# Local dev via Docker Compose (docker compose up -d) uses this by default.
# For a managed/cloud Postgres (Neon, Supabase, Railway, ...), just replace
# this with the connection string they give you — nothing else changes.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/realtor_shamraiz?schema=public"

# --- Server ---------------------------------------------------------------
NODE_ENV=development
API_PORT=4000

# Comma-separated list of origins allowed to call this API with credentials.
# The static site's dev server (server.js) runs on 5273 by default.
CORS_ORIGINS=http://localhost:5273

# How many reverse proxies sit in front of this process: "false" when it is
# exposed directly, otherwise the hop count (e.g. 1 behind nginx, 2 behind
# Cloudflare + nginx). Too high a value lets a client forge X-Forwarded-For
# and bypass every per-IP rate limit.
TRUST_PROXY=false

# --- Auth -------------------------------------------------------------------
# Generate real random secrets before anything but local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-please
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-please
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14

# --- Media storage --------------------------------------------------------
# Absolute or relative-to-server/ path where uploaded files are written.
MEDIA_STORAGE_DIR=./storage
MEDIA_MAX_IMAGE_MB=15
MEDIA_MAX_VIDEO_MB=500
MEDIA_MAX_DOCUMENT_MB=25

# --- Initial SUPER_ADMIN user (used only by `npm run db:seed`) ------------
# The seed script refuses to run without an email and password — no guessable
# default admin. SEED_ADMIN_USERNAME is optional: set it to keep signing in to
# the existing admin panel with a username as well as the email.
# QUOTE any value containing '#': unquoted, everything from the '#' onward is
# read as a comment, so the password you think you set is not the one stored.
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_NAME="Site Owner"
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD="change-this-before-seeding"

# --- First-run setup over HTTP (optional) ---------------------------------
# POST /auth/setup creates the admin account when no user exists yet. In
# production that endpoint additionally requires this token, so an attacker
# who finds the API with an empty database still cannot claim the panel.
# Leave unset to disable the endpoint in production entirely and create the
# admin with `npm run db:seed` instead (the recommended path).
# SETUP_TOKEN=
